{
  "name": "reporteseguro-app",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Sistema Profesional de Gestión de Incidencias de Seguridad con Colaboradores - Secure by Design",
  "keywords": [
    "seguridad",
    "reportes",
    "incidencias",
    "dashboard",
    "analytics",
    "colaboradores",
    "sst",
    "supabase",
    "react",
    "pwa",
    "security"
  ],
  "author": "Andres Felipe Benitez Grajales <felipe@reporteseguro.com>",
  "license": "MIT",
  "homepage": "https://reporteseguro.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/empresa/reporteseguro-app.git"
  },
  "bugs": {
    "url": "https://github.com/empresa/reporteseguro-app/issues",
    "email": "soporte@reporteseguro.com"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.56.1",
    "dotenv": "^17.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.1",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "recharts": "^2.15.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@alloc/quick-lru": "^5.2.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-security": "^1.7.1",
    "postcss": "^8.5.6",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx --fix",
    "lint:check": "eslint src --ext .js,.jsx",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,css,md}\"",
    "clean": "rm -rf dist node_modules/.vite"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2
  }
}
