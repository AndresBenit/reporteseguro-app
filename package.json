{
  "name": "reporteseguro-app",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Sistema Profesional de Gestión de Incidencias de Seguridad con Colaboradores - Secure by Design",
  "keywords": [
    "seguridad",
    "reportes",
    "incidencias",
    "dashboard",
    "analytics",
    "colaboradores",
    "sst",
    "supabase",
    "react",
    "pwa",
    "security"
  ],
  "author": "Andres Felipe Benitez Grajales <felipe@reporteseguro.com>",
  "license": "MIT",
  "homepage": "https://reporteseguro.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/empresa/reporteseguro-app.git"
  },
  "bugs": {
    "url": "https://github.com/empresa/reporteseguro-app/issues",
    "email": "soporte@reporteseguro.com"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.56.1",
    "dotenv": "^17.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.1",
    "recharts": "^2.15.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-security": "^1.7.1",
    "prettier": "^3.0.0",
    "vite": "^5.0.0"
  },
  "scripts": {
    "dev": "npx vite",
    "build": "npx vite build",
    "build-vercel": "node node_modules/vite/bin/vite.js build",
    "build:secure": "npm run security:audit && npm run lint && npm run build",
    "preview": "npx vite preview",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "lint:check": "eslint src --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "security:audit": "npm audit --audit-level moderate",
    "security:audit-fix": "npm audit fix",
    "security:audit-high": "npm audit --audit-level high",
    "security:scan": "npm run security:audit && npm run lint:security",
    "lint:security": "eslint src --ext .js,.jsx,.ts,.tsx --no-fix --config .eslintrc.security.js",
    "env:check": "node scripts/check-env.js",
    "env:validate": "node scripts/validate-env.js",
    "config:verify": "npm run env:check && npm run supabase:verify",
    "supabase:verify": "node scripts/verify-supabase.js",
    "supabase:migrate": "node scripts/migrate-from-firebase.js",
    "supabase:setup": "node scripts/setup-supabase.js",
    "test": "echo 'Tests not configured yet'",
    "test:unit": "echo 'Unit tests not configured yet'",
    "test:integration": "echo 'Integration tests not configured yet'",
    "test:e2e": "echo 'E2E tests not configured yet'",
    "test:security": "echo 'Security tests not configured yet'",
    "test:all": "npm run test:unit && npm run test:integration && npm run security:scan",
    "deploy": "npm run build:secure && vercel --prod",
    "deploy:staging": "npm run build && vercel",
    "deploy:production": "npm run build:secure && vercel --prod",
    "analyze": "npm run build && npx vite-bundle-analyzer dist",
    "clean": "rm -rf dist node_modules/.vite",
    "reinstall": "npm run clean && npm install",
    "setup": "npm install && npm run env:check && npm run config:verify",
    "setup:dev": "npm run setup && npm run supabase:setup",
    "docs:serve": "echo 'Documentation server not configured'",
    "docs:build": "echo 'Documentation build not configured'"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2
  },
  "pnpm": {
    "auditConfig": {
      "ignoreCves": []
    }
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint:check && npm run security:audit",
      "pre-push": "npm run test:all"
    }
  }
}
