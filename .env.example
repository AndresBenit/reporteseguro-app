# 🔐 VARIABLES DE ENTORNO - REPORETSEGURO APP
# ⚠️ IMPORTANTE: Nunca commitees este archivo con valores reales
# Este es un archivo de ejemplo. Crea tu propio .env.local con tus credenciales

# ==============================================================================
# 🚀 CONFIGURACIÓN SUPABASE
# ==============================================================================
# Obtén estos valores desde Supabase Dashboard > Settings > API

# Supabase URL - URL de tu proyecto Supabase
VITE_SUPABASE_URL=https://tu-project-ref.supabase.co

# Supabase Anon Key - Clave pública para acceder a Supabase
VITE_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# Supabase Service Role Key - Solo para scripts administrativos (opcional)
# ⚠️ NUNCA uses esta clave en el frontend, solo en scripts de servidor
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# ==============================================================================
# ⚙️ CONFIGURACIÓN DE LA APLICACIÓN
# ==============================================================================

# Nombre de la aplicación
VITE_APP_NAME="ReporteSeguro Enterprise"

# Versión de la aplicación
VITE_APP_VERSION="1.0.0"

# Entorno de ejecución
VITE_APP_ENV="development"

# URL base de la aplicación
VITE_APP_BASE_URL="http://localhost:5173"

# ==============================================================================
# 🔒 CONFIGURACIÓN DE SEGURIDAD
# ==============================================================================

# Clave para encriptación local (opcional)
VITE_ENCRYPTION_KEY=tu_clave_encriptacion_256_bits

# Tiempo de expiración de sesión en minutos
VITE_SESSION_TIMEOUT=60

# Máximo de intentos de login
VITE_MAX_LOGIN_ATTEMPTS=5

# ==============================================================================
# 📊 CONFIGURACIÓN DE ANALYTICS Y MONITORING
# ==============================================================================

# Sentry DSN para error tracking (opcional)
VITE_SENTRY_DSN=https://tu-sentry-dsn@sentry.io/tu-project-id

# Google Analytics ID (opcional, para tracking adicional)
VITE_GA_TRACKING_ID=GA-XXXXXXXXX

# PostHog para analytics (alternativa gratuita)
VITE_POSTHOG_KEY=tu_posthog_key_aqui
VITE_POSTHOG_HOST=https://app.posthog.com

# ==============================================================================
# 🌐 CONFIGURACIÓN DE TERCEROS
# ==============================================================================

# API Key para mapas (si usas Google Maps)
VITE_GOOGLE_MAPS_API_KEY=tu_google_maps_api_key

# Webhook para notificaciones Slack (opcional)
VITE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/tu/webhook/url

# ==============================================================================
# 🔧 INSTRUCCIONES DE CONFIGURACIÓN
# ==============================================================================

# 1. Copia este archivo y renómbralo como .env.local
# 2. Reemplaza todos los valores "tu_*" con tus credenciales reales
# 3. Guarda el archivo en la raíz del proyecto (mismo nivel que package.json)
# 4. Reinicia el servidor de desarrollo: npm run dev
# 5. El archivo .env.local está en .gitignore, no se subirá a Git

# ==============================================================================
# 🚨 NOTAS DE SEGURIDAD IMPORTANTES
# ==============================================================================

# ✅ DO (Hacer):
# - Mantén este archivo en .gitignore
# - Usa valores únicos para cada entorno (dev, staging, prod)
# - Rota las credenciales regularmente
# - Limita permisos en Firebase Console

# ❌ DON'T (No hacer):
# - Nunca commits valores reales
# - No compartir credenciales por email/chat
# - No usar credenciales de producción en desarrollo
# - No hardcodear valores en el código fuente

# ==============================================================================
# 📱 COMANDOS ÚTILES
# ==============================================================================

# Verificar configuración:
# npm run config:verify

# Validar variables de entorno:
# npm run env:validate

# Configurar Supabase:
# npm run supabase:setup

# Migrar desde Firebase:
# npm run supabase:migrate

# Deploy con variables específicas:
# npm run deploy

# ==============================================================================
# 📚 DOCUMENTACIÓN ADICIONAL
# ==============================================================================

# Para más información sobre configuración:
# - README.md sección "Configuración Segura"  
# - docs/CONFIGURATION.md
# - Supabase Documentation: https://supabase.com/docs
# - Vercel Documentation: https://vercel.com/docs
